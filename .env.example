# CampusTransit Agent - environment template.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# .env is git-ignored. Nothing here is required: with an empty .env the app runs on
# SQLite + GTFS + the built-in map, and every optional provider reports why it is off.
# Values below are placeholders. Never commit a real key.
#
# Which variable belongs where:
#   * server keys  -> stay in this process, never sent to the browser
#   * browser keys -> restricted by HTTP referrer, shipped to the page on purpose
#   * anything else -> local setting
#
# After editing: restart the server, then open Settings -> Integrations and press
# "Test connection" on the provider you configured. `GET /api/v1/config/health` reports
# whether each value has the right *shape* without ever echoing it.

# =============================================================== runtime ======
# development | test | production. Affects diagnostics only.
APP_ENV=development

# =============================================================== LLM (local) ==
# Ollama answers the chat. Routes, fares, metro network and KSRTC quotes come from the
# tools with or without a model; if the model is missing or slow the deterministic
# planner answers and the reply says why.
#
#   1. install Ollama                  https://ollama.com/download
#   2. ollama pull qwen2.5:0.5b
#   3. restart this server             (config is read at import time)
#   4. curl localhost:7860/api/chat/health
#
# Qwen 2.5 0.5B is a small tool-calling model. The planner and data tools remain the
# source of truth; increase to 1.5b/3b on machines with more memory if desired.
LLM_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://localhost:11434
# auto | on | off
LLM_ENABLED=auto
LLM_TEMPERATURE=0.1
# Per model call. A cold model load may take a minute before the first token.
OLLAMA_TIMEOUT_S=120
# Whole-turn wall-clock budget. When it runs out the rules engine answers instead of the
# request hanging; the browser waits this long plus 60 s (it is told via /api/chat).
CHAT_BUDGET_S=150

# =============================================================== embeddings ===
# chroma-default  = all-MiniLM-L6-v2 ONNX, shipped by chromadb (~80 MB, downloads once)
# sentence-transformers = set EMBED_MODEL to any local model name
EMBED_BACKEND=chroma-default
EMBED_MODEL=all-MiniLM-L6-v2

# =============================================================== map =========
# Leave MAP_PROVIDER unset and the app draws Leaflet/OSM (proxied through this server)
# or its own SVG transit map - works offline, no key.
# auto | google | osm | svg
MAP_PROVIDER=auto

# Browser key. Ships to the client, so RESTRICT IT BY HTTP REFERRER in Cloud Console:
#   https://console.cloud.google.com/google/maps-apis/credentials
# Never put a server key here.
# GOOGLE_MAPS_BROWSER_KEY=
# Only needed for a Map ID (vector maps / cloud styling).
# GOOGLE_MAPS_MAP_ID=

# OpenStreetMap tiles are proxied through /api/tiles/{z}/{x}/{y}.png: cached on disk for
# 7 days, capped at 4,000 tiles, descriptive User-Agent on every request (usage policy).
# OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# OSM_USER_AGENT=CampusTransit/1.0 (Bengaluru transit assistant; educational)

# =============================================================== Google (server)
# SERVER key - never sent to the browser, never used for fares.
# Required by: Places autocomplete, Geocoding (forward + reverse), Routes, live traffic.
# Enable only the APIs you use:
#   https://console.cloud.google.com/google/maps-apis/api-list
# Each of these is BILLED per request. See docs/INTEGRATIONS.md for the SKUs.
# GOOGLE_MAPS_SERVER_API_KEY=

# =============================================================== OpenRouteService
# Optional road routing. Free tier, rate-limited, NO live traffic (static OSM network).
#   https://account.heigit.org/signup
# OPENROUTESERVICE_API_KEY=

# =============================================================== TomTom ======
# Optional road routing WITH live traffic. Metered against a monthly allowance.
#   https://developer.tomtom.com/user/register
# TOMTOM_API_KEY=

# Which providers may answer a road-routing request, in order. A provider that is not
# configured, is switched off in Settings, or failed its last check is skipped.
# ROAD_ROUTING_CHAIN=google_routes,openrouteservice,tomtom
# Pin ONE provider and disable fallback (useful when comparing providers):
# ROAD_ROUTING_PROVIDER=openrouteservice

# =============================================================== realtime =====
# Live vehicle positions come from a GTFS-Realtime feed YOU are authorised to read.
# There is no feed in this repository and no default URL: BMTC publishes realtime data
# through IUDX to approved consumers, not as an open endpoint, and BMRCL's ONDC feed is
# not a public GTFS-RT URL. With this blank, the "Live buses" layer says "Unavailable"
# and the app draws nothing -- it does not fall back to schedule-derived guesses.
#
# The reader accepts protobuf (standard) and GTFS-RT JSON. Feed the URL of the
# Vehicle Positions resource; docs/GTFS_REALTIME.md section 2 explains how to get one.
# GTFS_RT_VEHICLE_URL=
# Optional: Trip Updates (arrival/departure predictions, a different feed type).
# GTFS_RT_TRIPUPDATES_URL=
#
# If your feed needs a token, put the WHOLE header line here. It is parsed on the server,
# never sent to the browser, and redacted from every response and log line.
# GTFS_RT_AUTH_HEADER=Authorization: Bearer <token-goes-here>
#
# Polling policy. The server caches the feed for at least 15s and shares one in-flight
# request between callers, so this is the floor on what the provider sees.
# GTFS_RT_POLL_INTERVAL_S=20
# A position older than this is labelled "delayed", never refreshed into looking current.
# GTFS_RT_STALE_AFTER_S=120

# =============================================================== HTTP client ==
# HTTP_TIMEOUT_SECONDS=8
# HTTP_MAX_RETRIES=2

# =============================================================== misc =========
# TRANSIT_TIMEZONE=Asia/Kolkata
# Overpass is not used as a runtime database; this only gates capability reporting.
# OVERPASS_ENABLED=1

# =============================================================== paths ========
# DB_PATH=data/processed/transit.db
# CHROMA_DIR=data/processed/chroma
